{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "UseJsonConsole": true,
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready",
    "HealthPath": "/health",
    "SensitiveKeys": [
      "password",
      "pwd",
      "passwd",
      "otp",
      "otpcode",
      "otp_value",
      "token",
      "accesstoken",
      "refreshtoken",
      "sessiontoken",
      "authorization",
      "bearer",
      "apikey",
      "api-key",
      "api_key",
      "secret",
      "signingkey",
      "clientsecret"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "Pagination": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "Bulk": {
    "MaxRowsPerOperation": 5000
  },
  "FileStorage": {
    "RootPath": "App_Data/files",
    "MaxSizeBytes": 26214400,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/pdf"
    ]
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "ClockSkewSeconds": 30
  },
  "Auth": {
    "LockoutThreshold": 5,
    "LockoutWindowMinutes": 15,
    "OtpExpiryMinutes": 10,
    "OtpLength": 6,
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30
  },
  "Notification": {
    "RunOutboxWorkerInApi": false,
    "OneSignalAppId": "",
    "OneSignalApiKey": "",
    "OneSignalApiBaseUrl": "https://api.onesignal.com/",
    "MaxDeliveryAttempts": 5,
    "RetryBackoffSeconds": 60,
    "OptionalCategoriesAllowedByDefault": true
  },
  "NotificationWorker": {
    "PollIntervalSeconds": 10,
    "BatchSize": 100
  },
  "Smtp": {
    "IsEnabled": false,
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromName": "App",
    "EnableSsl": true
  },
  "MessageOutboxWorker": {
    "RunInApi": false,
    "PollIntervalSeconds": 10,
    "BatchSize": 100,
    "MaxDeliveryAttempts": 5,
    "RetryBackoffSeconds": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Write": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Idempotency": {
    "RetentionDays": 30,
    "ReplayWaitAttempts": 20,
    "ReplayWaitDelayMs": 50
  }
}
