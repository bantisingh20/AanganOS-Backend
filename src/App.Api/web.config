<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Let PUT/DELETE/PATCH reach ASP.NET Core instead of being blocked by WebDAV. -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <!--
        The ASP.NET Core module handler is injected here by `dotnet publish`:
        <aspNetCore processPath="dotnet" arguments=".\CommunityOS.Api.dll"
                    stdoutLogEnabled="false" hostingModel="inprocess" />
      -->
    </system.webServer>
  </location>
</configuration>
